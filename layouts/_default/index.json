{{- $.Scratch.Set "index" slice -}}
{{- range where .Site.RegularPages "Type" "not in" (slice "page" "json") -}}
  {{- $page := . -}}
  {{- $content := $page.Plain | default "" -}} {{/* 获取文章内容 */}}
  {{- $defaultCover := resources.Get "default-cover.png" | fingerprint -}}
  {{- $cover := $page.Params.cover | default $defaultCover.RelPermalink -}} {{/* 获取封面图 */}}
  {{- $entry := dict
    "title" $page.Title
    "contents" $content
    "cover" $cover
    "permalink" $page.Permalink
  -}}
  {{- $.Scratch.Add "index" $entry -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}